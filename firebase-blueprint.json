{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Game products being sold (e.g., Drip Client 1 Day)",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Display name of the product" },
        "description": { "type": "string", "description": "Longer description" },
        "price": { "type": "number", "description": "Price in Rupiah" },
        "discount": { "type": "number", "description": "Percentage discount (0-100)" },
        "category": { "type": "string", "description": "e.g., Key, Tool" },
        "image": { "type": "string", "description": "Cover image URL" }
      },
      "required": ["name", "price", "category"]
    },
    "GameKey": {
      "title": "Game Key",
      "description": "Specific key for a product",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "description": "Reference to Product ID" },
        "key": { "type": "string", "description": "The actual key string" },
        "status": { "type": "string", "enum": ["available", "sold"] },
        "soldTo": { "type": "string", "format": "email" },
        "soldAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "key", "status"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Customer purchase transaction",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "amount": { "type": "number" },
        "customerEmail": { "type": "string", "format": "email" },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "keyDelivered": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "customerEmail", "amount", "status"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User account data including balance and role",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "reseller", "admin"] },
        "balance": { "type": "number" }
      }
    },
    "Deposit": {
      "title": "Deposit",
      "description": "Wallet top-up requests",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "cancelled"] },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Live chat community messages",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "role": { "type": "string" },
        "userCode": { "type": "string" }
      },
      "required": ["userId", "text", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of game products"
    },
    "/chat/{messageId}": {
      "schema": "ChatMessage",
      "description": "Community global chat"
    },
    "/keys/{keyId}": {
      "schema": "GameKey",
      "description": "Inventory of keys"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Sales logs"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account details"
    },
    "/deposits/{depositId}": {
      "schema": "Deposit",
      "description": "Wallet top-up logs"
    }
  }
}
